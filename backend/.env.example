DB_HOST=localhost
DB_PORT=5432
DB_NAME=pantry_nook
DB_USER=postgres
DB_PASSWORD=your_password_here
PORT=3000
FRONTEND_ORIGIN=https://yourdomain.com
APP_ENV=development
PANTRY_ALLOW_TEST_DATA=false
# 原件与展示副本的持久目录；相对路径按后端启动目录解析，禁止放入前端静态目录。
MEDIA_ROOT=../.local/media
# Windows 可填写已安装工具的完整路径；省略时从 PATH 查找。
# EXIFTOOL_PATH=exiftool
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
