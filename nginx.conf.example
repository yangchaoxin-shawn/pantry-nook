# Pantry Nook 项目片段参考。公司服务器（123.56.128.73）的完整步骤以 DEPLOY-SERVER.md 为唯一口径。
# 以下内容对应线上 /etc/nginx/snippets/system/pantry-nook.conf，由主块
# /etc/nginx/conf.d/system.conf include；不要改共享主块或其他项目片段。

location = /pantry-nook {
    return 302 /pantry-nook/;
}

location ^~ /pantry-nook/api/ {
    auth_basic "Private Area";
    auth_basic_user_file /etc/nginx/.pantry-nook.htpasswd;
    rewrite ^/pantry-nook/api/(.*)$ /api/$1 break;
    proxy_pass http://127.0.0.1:8016;
    proxy_http_version 1.1;
    client_max_body_size 52m;
    proxy_connect_timeout 15s;
    proxy_send_timeout 180s;
    proxy_read_timeout 180s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /pantry-nook/assets/ {
    auth_basic "Private Area";
    auth_basic_user_file /etc/nginx/.pantry-nook.htpasswd;
    alias /data/pantry-nook-frontend/assets/;
    try_files $uri $uri/ =404;
}

location ^~ /pantry-nook/ {
    auth_basic "Private Area";
    auth_basic_user_file /etc/nginx/.pantry-nook.htpasswd;
    alias /data/pantry-nook-frontend/;
    index index.html;
    try_files $uri $uri/ /pantry-nook/index.html;
}
