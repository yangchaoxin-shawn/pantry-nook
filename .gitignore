# Python 虚拟环境与缓存
.venv/
.backups/
__pycache__/
*.py[cod]

# 依赖与构建产物
node_modules/
.npm-cache/
.uv-cache/
*.tsbuildinfo
dist/
build/

# 环境变量与敏感配置
.env
.env.*
!.env.example
!frontend/.env.production

# 日志
*.log
npm-debug.log*

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude 个人本地配置、会话工具与隔离工作树（不共享）
CLAUDE.local.md
.claude/*

# Vite 本地缓存
.vite/

# 本地 UI 评审环境进程记录与日志
.review/
.local/
# 用户上传与本地媒体不进入版本库。
/backend/media/
/backend/uploads/
